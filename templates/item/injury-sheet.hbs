<section class="{{cssClass}} trespasser-sheet item-sheet injury-sheet" autocomplete="off">

  <!-- ─── HEADER ─── -->
  <header class="sheet-header item-header-layout">

    <!-- Item image -->
    <div class="header-column image-column">
      <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
    </div>

    <!-- Name + clock numbers -->
    <div class="header-column details-column">
      <h1 class="item-title">
        <input name="name" type="text" value="{{item.name}}"
               placeholder="{{localize 'TRESPASSER.Sheet.Header.Name'}}"/>
      </h1>
    </div>
  </header>

  <!-- ─── BODY ─── -->
  <section class="sheet-body scrollable">
    <div class="attribute-fields">
        <div class="attribute-group flex-row">
          <div class="field-item">
            <label>{{localize "TRESPASSER.Sheet.Item.Injury.InjuryClock"}}</label>
            <input type="number" name="system.injuryClock"
                    value="{{system.injuryClock}}" min="2" max="12" />
          </div>

          <div class="field-item">
            <label>{{localize "TRESPASSER.Sheet.Item.Injury.CurrentClock"}}</label>
            <input type="number" name="system.currentClock"
                    value="{{system.currentClock}}" min="0"
                    max="{{system.injuryClock}}" />
          </div>
        </div>
        <div class="field-row description-column">
          <label>{{localize "TRESPASSER.Sheet.Common.Description"}}</label>
          <div class="trp-editor-container">
            <prose-mirror name="system.description" value="{{system.description}}" toggled="false" compact="false" editable="{{editable}}">{{{descriptionHTML}}}</prose-mirror>
          </div>
        </div>
    </div>

    <div class="custom-attributes-area">

      <!-- SVG Clock display -->
      <h3 class="section-title">{{localize "TRESPASSER.Sheet.Item.Injury.Clock"}}</h3>
      <div class="injury-clock-area">
        {{> "systems/trespasser/templates/actor/parts/clock.hbs" 
            id=item.id 
            current=clockFilled 
            max=clockTotal 
            segments=clockSegments
            showMax=true
            svgClass="injury-clock-svg"
        }}

        <p class="clock-hint">
          {{localize "TRESPASSER.Sheet.Item.Injury.ClockHint"}}
        </p>
      </div>

      <!-- Effects drop zone -->
      <div style="margin-top: 15px; border-top: 1px solid var(--trp-border-light); padding-top: 10px;">
        {{> "systems/trespasser/templates/item/parts/effects-list.hbs"
            title=(localize "TRESPASSER.Sheet.Item.Injury.Effects")
            items=system.effects
            property="effects"
            deleteClass="effect-remove"}}
      </div>

    </div>
  </section>
</section>
