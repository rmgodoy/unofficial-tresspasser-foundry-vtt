<section class="tab details scrollable {{tab.cssClass}}" data-group="primary" data-tab="details">
  <div class="effect-details-body">
    {{!-- Rich Text Description Editor --}}
    <div class="effect-description-card">
      <div class="card-section-label">
        <i class="fas fa-feather-pointed"></i> {{localize "TRESPASSER.Sheet.Common.Description"}}
      </div>
      <div class="trp-editor-container effect-editor-tall">
        <prose-mirror name="system.description" value="{{system.description}}" toggled="false" compact="false" editable="{{editable}}">{{{descriptionHTML}}}</prose-mirror>
      </div>
    </div>

    {{!-- Token Status Icon & Priority Settings Card --}}
    <div class="effect-settings-card">
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Item.Details.StatusIcon"}}</label>
        <div class="status-icon-controls">
          <select name="system.statusIcon">
            <option value="__sync__" {{#if syncStatusIcon}}selected{{/if}}>
              {{localize "TRESPASSER.Sheet.Item.Details.SyncWithArtwork"}}
            </option>
            <option value="" {{#if (and (not syncStatusIcon) (not system.statusIcon))}}selected{{/if}}>
              {{localize "TRESPASSER.Sheet.Item.Details.NoStatusIcon"}}
            </option>
            {{#if isCustomStatus}}
              <option value="{{system.statusIcon}}" {{#if (and (not syncStatusIcon) system.statusIcon)}}selected{{/if}}>
                {{localize "TRESPASSER.Sheet.Item.Details.CustomStatusIcon"}}{{#if customStatusLabel}} ({{customStatusLabel}}){{/if}}
              </option>
            {{/if}}
            {{#each config.statusEffects as |se|}}
              <option value="{{se.img}}" {{#if (and (not ../syncStatusIcon) (eq ../system.statusIcon se.img))}}selected{{/if}}>
                {{se.name}}
              </option>
            {{/each}}
          </select>
          {{#if editable}}
          <button type="button" class="sync-icon-btn {{#if syncStatusIcon}}active{{/if}}" data-action="toggleSyncStatusIcon" title="{{#if syncStatusIcon}}{{localize 'TRESPASSER.Sheet.Item.Details.SyncedWithArtwork'}}{{else}}{{localize 'TRESPASSER.Sheet.Item.Details.SyncWithArtwork'}}{{/if}}">
            <i class="fas {{#if syncStatusIcon}}fa-link{{else}}fa-unlink{{/if}}"></i>
          </button>
          <button type="button" class="file-picker-btn" data-edit="system.statusIcon" title="{{localize 'TRESPASSER.Sheet.Item.Details.BrowseStatusIcon'}}">
            <i class="fas fa-file-import"></i>
          </button>
          {{/if}}
          {{#if effectiveStatusIcon}}
            <img class="status-icon-preview" src="{{effectiveStatusIcon}}" data-edit="system.statusIcon" title="{{localize 'TRESPASSER.Sheet.Item.Details.BrowseStatusIcon'}}" />
            {{#if editable}}
            <button type="button" class="status-icon-clear-btn" data-action="clearStatusIcon" title="{{localize 'TRESPASSER.Sheet.Item.Details.ClearStatusIcon'}}">
              <i class="fas fa-times"></i>
            </button>
            {{/if}}
          {{/if}}
        </div>
      </div>

      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Item.Effect.EffectPriority"}}</label>
        <input type="number" name="system.effectPriority" value="{{system.effectPriority}}" placeholder="{{localize 'TRESPASSER.Sheet.Common.Auto'}}" title="{{localize 'TRESPASSER.Sheet.Item.Effect.PriorityHint'}}" />
      </div>
    </div>
  </div>
</section>

