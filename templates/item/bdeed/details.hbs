<section class="tab details scrollable {{tab.cssClass}}" data-group="primary" data-tab="details">
  <div class="bdeed-details">
    <div class="details-grid">
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.BDeed.ActionType"}}</label>
        <select name="system.actionType">
          {{selectOptions config.actionTypes selected=system.actionType}}
        </select>
      </div>

      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.BDeed.AbilityType"}}</label>
        <select name="system.abilityType">
          {{selectOptions config.abilityTypes selected=system.abilityType}}
        </select>
      </div>

      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.BDeed.Versus"}}</label>
        <select name="system.versus">
          {{selectOptions config.versusChoices selected=system.versus}}
        </select>
      </div>

      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.BDeed.FocusCost"}}</label>
        <input type="number" name="system.focusCost" value="{{system.focusCost}}" placeholder="0" step="1" min="0" class="select-on-focus"/>
      </div>

      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.BDeed.Range"}}</label>
        <input type="number" name="system.range" value="{{system.range}}" placeholder="0" step="1" min="0" class="select-on-focus"/>
      </div>
    </div>
  </div>
</section>
