<section class="tab details scrollable {{tab.cssClass}}" data-group="primary" data-tab="details">
  <div class="deed-details">
    <div class="details-grid">
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Terrain.Fields.Category"}}</label>
        <select name="system.category">
          {{selectOptions config.categories selected=system.category}}
        </select>
      </div>
      
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Terrain.Fields.Dimensions"}}</label>
        <div style="display: flex; gap: 8px; align-items: center;">
          <input type="number" name="system.width" value="{{system.width}}" step="1" class="select-on-focus" />
          <span>&times;</span>
          <input type="number" name="system.height" value="{{system.height}}" step="1" class="select-on-focus" />
        </div>
      </div>
      
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Terrain.Fields.CenterMode"}}</label>
        <select name="system.centerMode">
          {{selectOptions config.centerModes selected=system.centerMode}}
        </select>
      </div>
      
      {{#if (eq system.centerMode "actor")}}
        <div class="field-row">
          <label>{{localize "TRESPASSER.Sheet.Terrain.Fields.CenterActorId"}}</label>
          <input type="text" name="system.centerActorId" value="{{system.centerActorId}}" />
        </div>
      {{/if}}
      
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Terrain.Fields.TerrainImage"}}</label>
        <file-picker type="image" name="system.terrainImage" value="{{system.terrainImage}}"></file-picker>
      </div>

      {{#if showTerrainDamage}}
        <div class="field-row">
          <label>{{localize "TRESPASSER.Sheet.Terrain.Fields.TerrainDamage"}}</label>
          <input type="number" name="system.terrainDamage" value="{{system.terrainDamage}}" step="1" class="select-on-focus" />
        </div>
      {{/if}}

      {{#if showExtraMovementCost}}
        <div class="field-row">
          <label>{{localize "TRESPASSER.Sheet.Terrain.Fields.ExtraMovementCost"}}</label>
          <input type="number" name="system.extraMovementCost" value="{{system.extraMovementCost}}" step="1" class="select-on-focus" />
        </div>
      {{/if}}
      
      {{#if showSlippery}}
        <div class="field-row checkbox-row">
          <input type="checkbox" name="system.slippery" {{checked system.slippery}} id="terrain-slippery-{{item.id}}" />
          <label for="terrain-slippery-{{item.id}}">{{localize "TRESPASSER.Sheet.Terrain.Fields.Slippery"}}</label>
        </div>
      {{/if}}

      {{#if showDestructible}}
        <div class="field-row checkbox-row">
          <input type="checkbox" name="system.destructible" {{checked system.destructible}} id="terrain-destructible-{{item.id}}" />
          <label for="terrain-destructible-{{item.id}}">{{localize "TRESPASSER.Sheet.Terrain.Fields.Destructible"}}</label>
        </div>
      {{/if}}

      {{!-- Region Color --}}
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Terrain.Fields.RegionColor"}}</label>
        <input type="color" name="system.regionColor" value="{{displayRegionColor}}" />
      </div>

      <hr/>

      {{!-- Linked Effects Drag and Drop --}}
      <div class="field-row" style="flex-direction: column; align-items: stretch; gap: 6px;">
        <label>{{localize "TRESPASSER.Sheet.Terrain.Fields.LinkedEffect"}}</label>
        <div class="linked-effect-drop-zone drop-zone" data-drop-target="linkedEffect">
          <i class="fas fa-file-import"></i> {{localize "TRESPASSER.Sheet.Item.Placeholder.DropEffects"}}
        </div>
        {{#if linkedEffectsList.length}}
          <div class="effect-chips-list" style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px;">
            {{#each linkedEffectsList}}
            <div class="effect-chip" data-index="{{@index}}" data-uuid="{{uuid}}">
              <input type="hidden" name="system.linkedEffects.{{@index}}.uuid" value="{{uuid}}"/>
              <input type="hidden" name="system.linkedEffects.{{@index}}.name" value="{{name}}"/>
              <input type="hidden" name="system.linkedEffects.{{@index}}.img" value="{{img}}"/>
              <img src="{{img}}" title="{{name}}"/>
              <span class="name">{{name}}</span>
              <div class="intensity-box">
                <span class="label">{{localize "TRESPASSER.Sheet.Common.IntensityShort"}}</span>
                <input type="text"
                       name="system.linkedEffects.{{@index}}.intensity"
                       value="{{intensity}}"
                       placeholder="1"
                       class="select-on-focus" style="width: 45px;"/>
              </div>
              <div class="controls">
                <a data-action="openEffectDoc" data-uuid="{{uuid}}" class="edit" title="{{localize 'TRESPASSER.Sheet.Common.Edit'}}"><i class="fas fa-edit"></i></a>
                <a data-action="removeLinkedEffect" data-effect-index="{{@index}}" class="remove" title="{{localize 'TRESPASSER.Sheet.Common.Delete'}}"><i class="fas fa-times"></i></a>
              </div>
            </div>
            {{/each}}
          </div>
        {{/if}}
      </div>

      <hr/>

      {{!-- Interactable Section --}}
      <div class="field-row checkbox-row">
        <input type="checkbox" name="system.interactable" {{checked system.interactable}} id="terrain-interactable-{{item.id}}" />
        <label for="terrain-interactable-{{item.id}}">{{localize "TRESPASSER.Sheet.Terrain.Fields.Interactable"}}</label>
      </div>

      {{#if system.interactable}}
        <div class="interact-config" style="margin-left: 16px; border-left: 2px solid var(--trp-border, #444); padding-left: 12px;">
          <div class="field-row">
            <label>{{localize "TRESPASSER.Sheet.Terrain.Fields.InteractLabel"}}</label>
            <input type="text" name="system.interactAction.label" value="{{system.interactAction.label}}"
                   placeholder="{{localize 'TRESPASSER.Sheet.Terrain.Placeholders.InteractLabel'}}" />
          </div>
          <div class="field-row">
            <label>{{localize "TRESPASSER.Sheet.Terrain.Fields.ActionCost"}}</label>
            <input type="number" name="system.interactAction.actionCost" value="{{system.interactAction.actionCost}}"
                   step="1" min="0" class="select-on-focus" />
          </div>
          <div class="field-row">
            <label>{{localize "TRESPASSER.Sheet.Terrain.Fields.ActionType"}}</label>
            <select name="system.interactAction.actionType">
              {{selectOptions config.interactActionTypes selected=system.interactAction.actionType}}
            </select>
          </div>
          {{#if (eq system.interactAction.actionType "moveTerrain")}}
            <div class="field-row">
              <label>{{localize "TRESPASSER.Sheet.Terrain.Fields.MoveDistance"}}</label>
              <input type="number" name="system.interactAction.moveDistance" value="{{system.interactAction.moveDistance}}"
                     step="1" min="0" class="select-on-focus" />
            </div>
            <div class="field-row">
              <label>{{localize "TRESPASSER.Sheet.Terrain.Fields.MoveEffect"}}</label>
              <select name="system.interactAction.moveEffect">
                {{selectOptions config.moveEffects selected=system.interactAction.moveEffect}}
              </select>
            </div>
          {{/if}}
        </div>
      {{/if}}
    </div>
  </div>
</section>
