<section class="tab phases scrollable {{tab.cssClass}}" data-group="primary" data-tab="phases" {{#unless tab.active}}hidden{{/unless}}>
  <div class="deed-phases-container">
    {{#each phases}}
    <div class="phase-card" data-phase="{{key}}">
      <div class="phase-card-header">
        <span class="phase-badge phase-badge-{{key}}">{{label}}</span>
        <label class="phase-skip-toggle">
          <input type="checkbox" name="system.phases.{{key}}.skipPhase" {{#if skipPhase}}checked{{/if}}/>
          {{localize "TRESPASSER.Sheet.Deed.SkipPhase"}}
        </label>
      </div>
      <div class="form-group phase-description-group">
        <textarea name="system.phases.{{key}}.description" rows="3" placeholder="{{localize 'TRESPASSER.Sheet.Item.Placeholder.Description'}}">{{description}}</textarea>
      </div>
    </div>
    {{/each}}
  </div>
</section>
