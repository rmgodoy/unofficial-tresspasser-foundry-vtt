<section class="tab effects deed-effects effects-body {{tab.cssClass}}" data-group="primary" data-tab="effects">
  <h3 class="effects-heading">{{localize "TRESPASSER.Sheet.Item.Sections.DeedEffects"}}</h3>

  {{#each phases as |phase|}}
  <div class="effect-block {{#if @last}}effect-block--last{{/if}}" data-phase="{{phase.key}}">
    <h4 class="effect-block__label">{{phase.label}}</h4>

    {{!-- Description --}}
    <div class="field-row full-width">
      <input type="text"
             name="system.effects.{{phase.key}}.description"
             value="{{phase.data.description}}"
             placeholder="{{localize (concat 'TRESPASSER.Sheet.Item.Placeholder.DeedDescription.' (capitalize phase.key))}}" />
    </div>

    <div class="effect-block__row">
      <div class="effect-block__damage-group">
        {{!-- Damage formula --}}
        <div class="field-row effect-block__damage">
          <input type="text"
                 name="system.effects.{{phase.key}}.damage"
                 value="{{phase.data.damage}}"
                 placeholder="{{localize 'TRESPASSER.Sheet.Common.Damage'}}"
                 class="select-on-focus" />
          <select name="system.effects.{{phase.key}}.damageMode">
            {{selectOptions @root.config.resolutionModes selected=phase.data.damageMode}}
          </select>
        </div>

        {{!-- Weapon effects checkbox --}}
        <label class="effect-block__weapon-toggle">
          <input type="checkbox"
                 name="system.effects.{{phase.key}}.appliesWeaponEffects"
                 {{checked phase.data.appliesWeaponEffects}} />
          {{localize "TRESPASSER.Sheet.Item.Sections.WeaponEffects"}}
        </label>
      </div>

      {{!-- Drop zone --}}
      <div class="applied-effects-list" data-phase="{{phase.key}}">
        {{#each phase.effects as |effect|}}
          <div class="effect-chip" data-index="{{effect.index}}" data-uuid="{{effect.uuid}}">
            <img src="{{effect.img}}" title="{{effect.name}}" />
            <span class="name">{{effect.name}}</span>
            <div class="intensity-box">
               <span class="label">{{localize "TRESPASSER.Sheet.Common.IntensityShort"}}</span>
               <input type="number"
                      class="effect-intensity-input"
                      name="system.effects.{{phase.key}}.appliedEffects.{{effect.index}}.intensity"
                      value="{{effect.intensity}}" />
               <input type="hidden" name="system.effects.{{phase.key}}.appliedEffects.{{effect.index}}.uuid" value="{{effect.uuid}}" />
               <input type="hidden" name="system.effects.{{phase.key}}.appliedEffects.{{effect.index}}.type" value="{{effect.type}}" />
               <input type="hidden" name="system.effects.{{phase.key}}.appliedEffects.{{effect.index}}.name" value="{{effect.name}}" />
               <input type="hidden" name="system.effects.{{phase.key}}.appliedEffects.{{effect.index}}.img" value="{{effect.img}}" />
            </div>
            <div class="controls">
              <a data-action="editEffect" title="{{localize 'TRESPASSER.Sheet.Common.Edit'}}"><i class="fas fa-edit"></i></a>
              <a data-action="removeEffect" title="{{localize 'TRESPASSER.Sheet.Common.Delete'}}"><i class="fas fa-times"></i></a>
            </div>
          </div>
        {{else}}
          <span class="drop-placeholder">{{localize "TRESPASSER.Sheet.Item.Placeholder.DropEffects"}}</span>
        {{/each}}
      </div>
      <div class="field-row full-width">
        <select name="system.effects.{{phase.key}}.appliedEffectsMode" style="width: 120px; margin-left: auto;">
          {{selectOptions @root.config.resolutionModes selected=phase.data.appliedEffectsMode}}
        </select>
      </div>

      {{!-- Forced Movement --}}
      <div class="field-row full-width forced-movement-row">
        <span class="label">{{localize "TRESPASSER.Sheet.Item.Sections.ForcedMovement"}}</span>
        <select name="system.effects.{{phase.key}}.forcedMovement.type">
          {{selectOptions @root.config.forcedMovementTypes selected=phase.data.forcedMovement.type blank=""}}
        </select>
        <input type="number" 
               name="system.effects.{{phase.key}}.forcedMovement.distance"
               value="{{phase.data.forcedMovement.distance}}"
               placeholder="{{localize 'TRESPASSER.Sheet.Common.Distance'}}" />
        <select name="system.effects.{{phase.key}}.forcedMovement.mode">
          {{selectOptions @root.config.forcedMovementModes selected=phase.data.forcedMovement.mode}}
        </select>
      </div>

      {{!-- Terrain Spawn --}}
      <div class="field-row full-width terrain-spawn-row">
        <span class="label">{{localize "TRESPASSER.Sheet.Item.Sections.TerrainSpawn"}}</span>
        <div class="terrain-drop-zone" data-phase="{{phase.key}}">
          {{#if phase.data.terrainSpawn.uuid}}
            <div class="terrain-chip" data-uuid="{{phase.data.terrainSpawn.uuid}}">
              <img src="{{phase.data.terrainSpawn.img}}" title="{{phase.data.terrainSpawn.name}}" />
              <span class="name">{{phase.data.terrainSpawn.name}}</span>
              <div class="controls">
                <a data-action="editTerrain" title="{{localize 'TRESPASSER.Sheet.Common.Edit'}}"><i class="fas fa-edit"></i></a>
                <a data-action="removeTerrain" title="{{localize 'TRESPASSER.Sheet.Common.Delete'}}"><i class="fas fa-times"></i></a>
              </div>
            </div>
          {{else}}
            <span class="drop-placeholder">{{localize "TRESPASSER.Sheet.Item.Placeholder.DropTerrain"}}</span>
          {{/if}}
        </div>
        <select name="system.effects.{{phase.key}}.terrainSpawn.placement">
          {{selectOptions @root.config.terrainPlacementChoices selected=phase.data.terrainSpawn.placement blank=""}}
        </select>
        <input type="text"
               name="system.effects.{{phase.key}}.terrainSpawn.linkedEffectUuid"
               value="{{phase.data.terrainSpawn.linkedEffectUuid}}"
               placeholder="{{localize 'TRESPASSER.Sheet.Item.Placeholder.LinkedEffectUuid'}}" />
        <select name="system.effects.{{phase.key}}.terrainSpawnMode">
          {{selectOptions @root.config.resolutionModes selected=phase.data.terrainSpawnMode}}
        </select>
      </div>

      {{!-- Phase Actions --}}
      <div class="field-row full-width phase-actions-header">
        <span class="label">Phase Actions (Before Damage/Effects)</span>
        <a data-action="addPhaseAction" title="Add Phase Action"><i class="fas fa-plus"></i></a>
      </div>
      <div class="phase-actions-list" data-phase="{{phase.key}}">
        {{#each phase.phaseActions as |action|}}
          <div class="phase-action-row field-row" data-index="{{action.index}}">
            <select name="system.effects.{{phase.key}}.phaseActions.{{action.index}}.type">
              {{selectOptions @root.config.phaseActionTypes selected=action.type}}
            </select>
            
            {{#if (eq action.type "movement")}}
              <select name="system.effects.{{phase.key}}.phaseActions.{{action.index}}.movementType">
                {{selectOptions @root.config.movementTypes selected=action.movementType}}
              </select>
              <select name="system.effects.{{phase.key}}.phaseActions.{{action.index}}.movementShape">
                {{selectOptions @root.config.movementShapes selected=action.movementShape}}
              </select>
              <input type="number" 
                     name="system.effects.{{phase.key}}.phaseActions.{{action.index}}.movementDistance"
                     value="{{action.movementDistance}}"
                     placeholder="{{localize 'TRESPASSER.Sheet.Common.Distance'}}" />
            {{/if}}

            {{#if (eq action.type "selfEffect")}}
              <input type="text"
                     name="system.effects.{{phase.key}}.phaseActions.{{action.index}}.effectUuid"
                     value="{{action.effectUuid}}"
                     placeholder="Effect UUID" />
            {{/if}}

            <a data-action="removePhaseAction" title="Remove"><i class="fas fa-trash"></i></a>
          </div>
        {{/each}}
      </div>
    </div>
  </div>
  {{/each}}
</section>
