<section class="tab details scrollable {{tab.cssClass}}" data-group="primary" data-tab="details" {{#unless tab.active}}hidden{{/unless}}>
  <div class="deed-details">
    <div class="details-grid">
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.ActionType"}}</label>
        <select name="system.actionType">
          {{selectOptions config.actionTypes selected=system.actionType}}
        </select>
      </div>

      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.AbilityType"}}</label>
        <select name="system.abilityType">
          {{selectOptions config.abilityTypes selected=system.abilityType}}
        </select>
      </div>

      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.Versus"}}</label>
        <select name="system.versus">
          {{selectOptions config.versusChoices selected=system.versus}}
        </select>
      </div>

      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Item.Details.FocusCost"}}</label>
        <input type="number" name="system.focusCost" value="{{system.focusCost}}" placeholder="{{localize 'TRESPASSER.Sheet.Common.Auto'}}" step="1" min="0" class="select-on-focus"/>
      </div>

      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Item.Details.FocusIncrease"}}</label>
        <input type="number" name="system.focusIncrease" value="{{system.focusIncrease}}" placeholder="{{localize 'TRESPASSER.Sheet.Common.Auto'}}" step="1" min="0" class="select-on-focus"/>
      </div>

      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Item.Details.BonusCost"}}</label>
        <input type="number" name="system.bonusCost" value="{{system.bonusCost}}" placeholder="0" step="1" min="0" class="select-on-focus"/>
      </div>

      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.Range"}}</label>
        <input type="number" name="system.range" value="{{system.range}}" placeholder="0" step="1" min="0" class="select-on-focus"/>
      </div>
    </div>
  </div>
</section>
