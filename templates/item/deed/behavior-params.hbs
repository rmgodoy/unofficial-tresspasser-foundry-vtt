<div class="behavior-params-form">
  {{#if hasRefRoll}}
    <div class="ref-chip-header">
      <span class="ref-chip" title="{{localize 'TRESPASSER.Sheet.Deed.Graph.ReferencedSource' id=refRollId}}">
        <i class="fas fa-link"></i> #{{refRollIdShort}} {{#if refRollExpr}}({{refRollExpr}}){{/if}}
      </span>
    </div>
  {{else if hasRefArea}}
    <div class="ref-chip-header">
      <span class="ref-chip" title="{{localize 'TRESPASSER.Sheet.Deed.Graph.ReferencedSource' id=refAreaId}}">
        <i class="fas fa-link"></i> #{{refAreaIdShort}} {{#if refAreaSummary}}({{refAreaSummary}}){{/if}}
      </span>
    </div>
  {{else if hasRefTerrain}}
    <div class="ref-chip-header">
      <span class="ref-chip" title="{{localize 'TRESPASSER.Sheet.Deed.Graph.ReferencedSource' id=refTerrainId}}">
        <i class="fas fa-link"></i> #{{refTerrainIdShort}} {{#if refTerrainName}}({{refTerrainName}}){{/if}}
      </span>
    </div>
  {{/if}}

  {{#if (eq type "start")}}
    <div class="behavior-hint-box">
      <p class="hint-title"><i class="fas fa-play"></i> {{localize "TRESPASSER.Sheet.Deed.Behavior.Type.start"}}</p>
      <p class="hint-text">{{localize "TRESPASSER.Sheet.Deed.Params.StartHint"}}</p>
    </div>
  {{/if}}

  {{#if (eq type "rollAccuracy")}}
    <div class="behavior-hint-box">
      <p class="hint-title"><i class="fas fa-crosshairs"></i> {{localize "TRESPASSER.Sheet.Deed.Behavior.Type.rollAccuracy"}}</p>
      <p class="hint-text">{{localize "TRESPASSER.Sheet.Deed.Params.RollAccuracyHint"}}</p>
    </div>

    <div class="param-row-grid">
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.ActionType"}}</label>
        <select name="system.graph.nodes.{{index}}.params.actionType">
          <option value="attack" {{#if (or (eq params.actionType "attack") (and (not params.actionType) (eq defaultActionType "attack")))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.ActionTypeChoices.Attack"}}</option>
          <option value="support" {{#if (or (eq params.actionType "support") (and (not params.actionType) (eq defaultActionType "support")))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.ActionTypeChoices.Support"}}</option>
        </select>
      </div>

      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.AbilityType"}}</label>
        <select name="system.graph.nodes.{{index}}.params.abilityType">
          <option value="innate" {{#if (or (eq params.abilityType "innate") (and (not params.abilityType) (eq defaultAbilityType "innate")))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TypeChoices.Innate"}}</option>
          <option value="melee" {{#if (or (eq params.abilityType "melee") (and (not params.abilityType) (eq defaultAbilityType "melee")))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TypeChoices.Melee"}}</option>
          <option value="missile" {{#if (or (eq params.abilityType "missile") (and (not params.abilityType) (eq defaultAbilityType "missile")))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TypeChoices.Missile"}}</option>
          <option value="spell" {{#if (or (eq params.abilityType "spell") (and (not params.abilityType) (eq defaultAbilityType "spell")))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TypeChoices.Spell"}}</option>
          <option value="tool" {{#if (or (eq params.abilityType "tool") (and (not params.abilityType) (eq defaultAbilityType "tool")))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TypeChoices.Tool"}}</option>
          <option value="unarmed" {{#if (or (eq params.abilityType "unarmed") (and (not params.abilityType) (eq defaultAbilityType "unarmed")))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TypeChoices.Unarmed"}}</option>
          <option value="versatile" {{#if (or (eq params.abilityType "versatile") (and (not params.abilityType) (eq defaultAbilityType "versatile")))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TypeChoices.Versatile"}}</option>
        </select>
      </div>

      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.Versus"}}</label>
        <select name="system.graph.nodes.{{index}}.params.versus">
          <option value="Guard" {{#if (or (eq params.versus "Guard") (and (not params.versus) (eq defaultVersus "Guard")))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Combat.Guard"}}</option>
          <option value="Resist" {{#if (or (eq params.versus "Resist") (and (not params.versus) (eq defaultVersus "Resist")))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Combat.Resist"}}</option>
          <option value="10" {{#if (or (eq params.versus "10") (and (not params.versus) (eq defaultVersus "10")))}}selected{{/if}}>10</option>
        </select>
      </div>

      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.Params.BranchingMode"}}</label>
        <select name="system.graph.nodes.{{index}}.params.branchingMode">
          <option value="hitThenSpark" {{#if (or (eq params.branchingMode "hitThenSpark") (not params.branchingMode))}}selected{{/if}}>
            {{localize "TRESPASSER.Sheet.Deed.Params.BranchingModeHitThenSpark"}}
          </option>
          <option value="hitOrSpark" {{#if (eq params.branchingMode "hitOrSpark")}}selected{{/if}}>
            {{localize "TRESPASSER.Sheet.Deed.Params.BranchingModeHitOrSpark"}}
          </option>
        </select>
      </div>
    </div>
  {{/if}}

  {{#if (eq type "selectTarget")}}
    <div class="param-row-grid">
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.Params.TargetMode"}}</label>
        <select name="system.graph.nodes.{{index}}.params.targetMode" {{#if hasRefArea}}disabled class="is-ref-locked" title="{{localize 'TRESPASSER.Sheet.Deed.Graph.ControlledByReference'}}"{{/if}}>
          <option value="self" {{#if (and (eq params.targetMode "self") (not hasRefArea))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.TargetModeChoices.Personal"}}</option>
          <option value="creatures" {{#if (and (eq params.targetMode "creatures") (not hasRefArea))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.TargetModeChoices.Creature"}}</option>
          <option value="aoe" {{#if (and (eq params.targetMode "aoe") (not hasRefArea))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.TargetModeChoices.AoE"}}</option>
          <option value="area" {{#if (or (eq params.targetMode "area") hasRefArea)}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.TargetModeChoices.SelectedArea"}}</option>
        </select>
        {{#if hasRefArea}}
          <input type="hidden" name="system.graph.nodes.{{index}}.params.targetMode" value="area"/>
        {{/if}}
      </div>

      {{#if (ne params.targetMode "self")}}
        <div class="field-row">
          <label>{{localize "TRESPASSER.Sheet.Deed.Params.Disposition"}}</label>
          <select name="system.graph.nodes.{{index}}.params.disposition">
            <option value="any" {{#if (or (eq params.disposition "any") (not params.disposition))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.DispositionChoices.Any"}}</option>
            <option value="enemy" {{#if (eq params.disposition "enemy")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.DispositionChoices.Enemy"}}</option>
            <option value="ally" {{#if (eq params.disposition "ally")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.DispositionChoices.Ally"}}</option>
            <option value="friendly" {{#if (eq params.disposition "friendly")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.DispositionChoices.Friendly"}}</option>
            <option value="neutral" {{#if (eq params.disposition "neutral")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.DispositionChoices.Neutral"}}</option>
            <option value="hostile" {{#if (eq params.disposition "hostile")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.DispositionChoices.Hostile"}}</option>
            <option value="secret" {{#if (eq params.disposition "secret")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.DispositionChoices.Secret"}}</option>
          </select>
        </div>
      {{/if}}

      {{#if (or (eq params.targetMode "creatures") (and (or (eq params.targetMode "aoe") (eq params.targetMode "area")) params.chooseCreatures))}}
        <div class="field-row">
          <label>{{localize "TRESPASSER.Sheet.Deed.Params.TargetCount"}}</label>
          <input type="number" name="system.graph.nodes.{{index}}.params.targetCount"
                 value="{{#if params.targetCount}}{{params.targetCount}}{{else}}1{{/if}}" min="1" step="1" class="select-on-focus"/>
        </div>
      {{/if}}

      {{#if (eq params.targetMode "aoe")}}
        <div class="field-row">
          <label>{{localize "TRESPASSER.Sheet.Deed.Params.AoEType"}}</label>
          <select name="system.graph.nodes.{{index}}.params.aoeType">
            <option value="blast" {{#if (or (eq params.aoeType "blast") (not params.aoeType))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TargetTypeChoices.Blast"}}</option>
            <option value="close_blast" {{#if (eq params.aoeType "close_blast")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TargetTypeChoices.CloseBlast"}}</option>
            <option value="burst" {{#if (eq params.aoeType "burst")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TargetTypeChoices.Burst"}}</option>
            <option value="melee_burst" {{#if (eq params.aoeType "melee_burst")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TargetTypeChoices.MeleeBurst"}}</option>
            <option value="path" {{#if (eq params.aoeType "path")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TargetTypeChoices.Path"}}</option>
            <option value="close_path" {{#if (eq params.aoeType "close_path")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TargetTypeChoices.ClosePath"}}</option>
            <option value="aura" {{#if (eq params.aoeType "aura")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TargetTypeChoices.Aura"}}</option>
          </select>
        </div>
        <div class="field-row">
          <label>{{localize "TRESPASSER.Sheet.Deed.Params.AoESize"}}</label>
          <input type="number" name="system.graph.nodes.{{index}}.params.aoeSize"
                 value="{{#if params.aoeSize}}{{params.aoeSize}}{{else}}1{{/if}}" min="1" step="1" class="select-on-focus"/>
        </div>
      {{/if}}

      {{#if (eq params.targetMode "area")}}
        <input type="hidden" name="system.graph.nodes.{{index}}.params.areaBehaviorId" value="{{params.areaBehaviorId}}"/>
        <div class="field-row">
          <label>{{localize "TRESPASSER.Sheet.Deed.Params.AreaRelation"}}</label>
          <select name="system.graph.nodes.{{index}}.params.areaRelation">
            <option value="inside" {{#if (or (eq params.areaRelation "inside") (not params.areaRelation))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.AreaRelationChoices.Inside"}}</option>
            <option value="adjacent" {{#if (eq params.areaRelation "adjacent")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.AreaRelationChoices.Adjacent"}}</option>
            <option value="insideAndAdjacent" {{#if (eq params.areaRelation "insideAndAdjacent")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.AreaRelationChoices.InsideAndAdjacent"}}</option>
          </select>
        </div>
      {{/if}}
    </div>

    {{#if (or (and (or (eq params.targetMode "aoe") (eq params.targetMode "area")) params.chooseCreatures) (ne params.targetMode "self") (eq params.targetMode "aoe") (eq params.targetMode "area"))}}
      <div class="behavior-checkboxes-row">
        {{#if (or (eq params.targetMode "aoe") (eq params.targetMode "area"))}}
          <div class="field-row checkbox-row">
            <input type="checkbox"
                   name="system.graph.nodes.{{index}}.params.chooseCreatures"
                   {{#if params.chooseCreatures}}checked{{/if}}
                   id="deed-choose-creatures-{{id}}"/>
            <label for="deed-choose-creatures-{{id}}">
              {{localize "TRESPASSER.Sheet.Deed.Params.ChooseCreatures"}}
            </label>
          </div>
        {{/if}}

        {{#if (ne params.targetMode "self")}}
          <div class="field-row checkbox-row">
            <input type="checkbox"
                   name="system.graph.nodes.{{index}}.params.ignoreSelf"
                   {{#if params.ignoreSelf}}checked{{/if}}
                   id="deed-ignore-self-{{id}}"/>
            <label for="deed-ignore-self-{{id}}">
              {{localize "TRESPASSER.Sheet.Deed.Params.IgnoreSelf"}}
            </label>
          </div>
        {{/if}}
      </div>
    {{/if}}
  {{/if}}

  {{#if (eq type "selectArea")}}
    <div class="param-row-grid">
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.Params.TargetMode"}}</label>
        <select name="system.graph.nodes.{{index}}.params.targetMode">
          <option value="squares" {{#if (or (eq params.targetMode "squares") (not params.targetMode))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.TargetModeChoices.Squares"}}</option>
          <option value="aoe" {{#if (eq params.targetMode "aoe")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.TargetModeChoices.AoE"}}</option>
        </select>
      </div>

      {{#if (or (eq params.targetMode "squares") (not params.targetMode))}}
        <div class="field-row">
          <label>{{localize "TRESPASSER.Sheet.Deed.Params.SquareCount"}}</label>
          <input type="number" name="system.graph.nodes.{{index}}.params.targetCount"
                 value="{{params.targetCount}}" min="1" step="1" class="select-on-focus"/>
        </div>
      {{/if}}

      {{#if (eq params.targetMode "aoe")}}
        <div class="field-row">
          <label>{{localize "TRESPASSER.Sheet.Deed.Params.AoEType"}}</label>
          <select name="system.graph.nodes.{{index}}.params.aoeType">
            <option value="blast" {{#if (or (eq params.aoeType "blast") (not params.aoeType))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TargetTypeChoices.Blast"}}</option>
            <option value="close_blast" {{#if (eq params.aoeType "close_blast")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TargetTypeChoices.CloseBlast"}}</option>
            <option value="burst" {{#if (eq params.aoeType "burst")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TargetTypeChoices.Burst"}}</option>
            <option value="melee_burst" {{#if (eq params.aoeType "melee_burst")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TargetTypeChoices.MeleeBurst"}}</option>
            <option value="path" {{#if (eq params.aoeType "path")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TargetTypeChoices.Path"}}</option>
            <option value="close_path" {{#if (eq params.aoeType "close_path")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TargetTypeChoices.ClosePath"}}</option>
            <option value="aura" {{#if (eq params.aoeType "aura")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TargetTypeChoices.Aura"}}</option>
          </select>
        </div>
        <div class="field-row">
          <label>{{localize "TRESPASSER.Sheet.Deed.Params.AoESize"}}</label>
          <input type="number" name="system.graph.nodes.{{index}}.params.aoeSize"
                 value="{{#if params.aoeSize}}{{params.aoeSize}}{{else}}1{{/if}}" min="1" step="1" class="select-on-focus"/>
        </div>
      {{/if}}
    </div>
  {{/if}}

  {{#if (eq type "roll")}}
    <div class="param-row-grid">
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.Params.RollExpression"}}</label>
        <div class="formula-input-group {{#if hasRefRoll}}has-reference{{/if}}">
          {{#if hasRefRoll}}
            <span class="formula-ref-badge" title="{{localize 'TRESPASSER.Sheet.Deed.Graph.ReferencedRollTooltip' id=refRollIdShort formula=refRollExpr}}">
              {{#if refRollExpr}}({{{formatDice refRollExpr}}}){{else}}#{{refRollIdShort}}{{/if}}
            </span>
          {{/if}}
          <input type="text" name="system.graph.nodes.{{index}}.params.expression"
                 value="{{params.expression}}"
                 placeholder="{{#if hasRefRoll}}/2, +5, -8, *2, +1d6{{else}}e.g. 2d6+STR, 1d8...{{/if}}"/>
        </div>
      </div>
      <input type="hidden" name="system.graph.nodes.{{index}}.params.rollBehaviorId" value="{{params.rollBehaviorId}}"/>
    </div>
    <div class="behavior-checkboxes-row">
      <div class="field-row checkbox-row">
        <input type="checkbox"
               name="system.graph.nodes.{{index}}.params.usePowerSparks"
               {{#if params.usePowerSparks}}checked{{/if}}
               id="deed-use-power-{{id}}"/>
        <label for="deed-use-power-{{id}}">
          {{localize "TRESPASSER.Sheet.Deed.Params.UsePowerSparks"}}
        </label>
      </div>
    </div>
  {{/if}}

  {{#if (eq type "applyDamage")}}
    <div class="param-row-grid">
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.Params.DamageExpression"}}</label>
        <div class="formula-input-group {{#if hasRefRoll}}has-reference{{/if}}">
          {{#if hasRefRoll}}
            <span class="formula-ref-badge" title="{{localize 'TRESPASSER.Sheet.Deed.Graph.ReferencedRollTooltip' id=refRollIdShort formula=refRollExpr}}">
              {{#if refRollExpr}}({{{formatDice refRollExpr}}}){{else}}#{{refRollIdShort}}{{/if}}
            </span>
          {{/if}}
          <input type="text" name="system.graph.nodes.{{index}}.params.expression"
                 value="{{params.expression}}"
                 placeholder="{{#if hasRefRoll}}/2, +5, -8, *2, +1d6{{else}}e.g. 2d6+STR, /2, -5, +1d6{{/if}}"/>
        </div>
      </div>
      <input type="hidden" name="system.graph.nodes.{{index}}.params.rollBehaviorId" value="{{params.rollBehaviorId}}"/>
    </div>
    <div class="behavior-checkboxes-row">
      <div class="field-row checkbox-row">
        <input type="checkbox"
               name="system.graph.nodes.{{index}}.params.distribute"
               {{#if params.distribute}}checked{{/if}}
               id="deed-distribute-damage-{{id}}"/>
        <label for="deed-distribute-damage-{{id}}">
          {{localize "TRESPASSER.Sheet.Deed.Params.DistributeDamage"}}
        </label>
      </div>
    </div>
  {{/if}}

  {{#if (or (eq type "healTarget") (eq type "applyHealing"))}}
    <div class="param-row-grid">
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.Params.HealingExpression"}}</label>
        <div class="formula-input-group {{#if hasRefRoll}}has-reference{{/if}}">
          {{#if hasRefRoll}}
            <span class="formula-ref-badge" title="{{localize 'TRESPASSER.Sheet.Deed.Graph.ReferencedRollTooltip' id=refRollIdShort formula=refRollExpr}}">
              {{#if refRollExpr}}({{{formatDice refRollExpr}}}){{else}}#{{refRollIdShort}}{{/if}}
            </span>
          {{/if}}
          <input type="text" name="system.graph.nodes.{{index}}.params.expression"
                 value="{{params.expression}}"
                 placeholder="{{#if hasRefRoll}}/2, +5, -8, *2, +1d6{{else}}e.g. 1d6+<sd>, /2, -5, +2{{/if}}"/>
        </div>
      </div>
      <input type="hidden" name="system.graph.nodes.{{index}}.params.rollBehaviorId" value="{{params.rollBehaviorId}}"/>
    </div>
    <div class="behavior-checkboxes-row">
      <div class="field-row checkbox-row">
        <input type="checkbox"
               name="system.graph.nodes.{{index}}.params.distribute"
               {{#if params.distribute}}checked{{/if}}
               id="deed-distribute-healing-{{id}}"/>
        <label for="deed-distribute-healing-{{id}}">
          {{localize "TRESPASSER.Sheet.Deed.Params.DistributeHealing"}}
        </label>
      </div>
    </div>
  {{/if}}

  {{#if (or (eq type "grantRecovery") (eq type "grantRecoveryToTarget"))}}
    <div class="param-row-grid">
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.Params.Intensity"}}</label>
        <input type="number" name="system.graph.nodes.{{index}}.params.intensity"
               value="{{params.intensity}}" min="1" step="1" placeholder="1" class="select-on-focus"/>
      </div>
    </div>
  {{/if}}

  {{#if (eq type "applyEffects")}}
    <div class="behavior-effects-section">
      <div class="behavior-checkboxes-row" style="margin-top: 0; margin-bottom: 6px;">
        <div class="field-row checkbox-row weapon-effects-toggle">
          <input type="checkbox"
                 name="system.graph.nodes.{{index}}.params.appliesWeaponEffects"
                 {{#if params.appliesWeaponEffects}}checked{{/if}}
                 id="deed-weapon-effects-{{id}}"/>
          <label for="deed-weapon-effects-{{id}}">
            {{localize "TRESPASSER.Sheet.Item.Sections.WeaponEffects"}}
          </label>
        </div>
      </div>
      <div class="behavior-effect-drop drop-zone" data-node-id="{{id}}" data-node-index="{{index}}">
        <i class="fas fa-file-import"></i> {{localize "TRESPASSER.Sheet.Item.Placeholder.DropEffects"}}
      </div>
      {{#if params.effects.length}}
        <div class="effect-chips-list">
          {{#each params.effects}}
          <div class="effect-chip">
            <input type="hidden" name="system.graph.nodes.{{../index}}.params.effects.{{@index}}.uuid" value="{{uuid}}"/>
            <input type="hidden" name="system.graph.nodes.{{../index}}.params.effects.{{@index}}.name" value="{{name}}"/>
            <input type="hidden" name="system.graph.nodes.{{../index}}.params.effects.{{@index}}.img" value="{{img}}"/>
            <img src="{{img}}" title="{{name}}"/>
            <span class="chip-name">{{name}}</span>
            <label class="intensity-label">Int:</label>
            <input type="number" name="system.graph.nodes.{{../index}}.params.effects.{{@index}}.intensity"
                   value="{{intensity}}" min="0" step="1" class="select-on-focus"/>
            <button type="button" class="remove-effect-btn" data-action="removeBehaviorEffect" data-node-id="{{../id}}" data-node-index="{{../index}}" data-effect-index="{{@index}}" title="{{localize 'TRESPASSER.Sheet.Deed.Params.ClearEffect'}}">
              <i class="fas fa-times"></i>
            </button>
          </div>
          {{/each}}
        </div>
      {{/if}}
    </div>
  {{/if}}

  {{#if (eq type "spawnTerrain")}}
    <div class="behavior-terrain-section">
      <input type="hidden" name="system.graph.nodes.{{index}}.params.terrainUuid" value="{{params.terrainUuid}}"/>
      <input type="hidden" name="system.graph.nodes.{{index}}.params.terrainName" value="{{params.terrainName}}"/>
      <input type="hidden" name="system.graph.nodes.{{index}}.params.terrainImg" value="{{params.terrainImg}}"/>
      <div class="behavior-terrain-drop drop-zone" data-node-id="{{id}}" data-node-index="{{index}}">
        {{#if params.terrainName}}
          <div class="terrain-chip">
            <img src="{{params.terrainImg}}" title="{{params.terrainName}}"/>
            <span class="chip-name">{{params.terrainName}}</span>
            {{#if terrainHasLinkedEffect}}
              <label class="intensity-label">{{localize "TRESPASSER.Sheet.Common.IntensityShort"}}:</label>
              <input type="number" name="system.graph.nodes.{{index}}.params.intensity"
                     value="{{#if (or params.intensity (eq params.intensity 0))}}{{params.intensity}}{{else}}1{{/if}}"
                     min="0" step="1" class="select-on-focus"/>
            {{/if}}
            <button type="button" class="clear-terrain-btn" data-action="clearBehaviorTerrain" data-node-id="{{id}}" title="{{localize 'TRESPASSER.Sheet.Deed.Params.ClearTerrain'}}">
              <i class="fas fa-times"></i>
            </button>
          </div>
        {{else}}
          <i class="fas fa-file-import"></i> {{localize "TRESPASSER.Sheet.Item.Placeholder.DropTerrain"}}
        {{/if}}
      </div>
      <div class="param-row-grid" style="margin-top: 6px;">
        <div class="field-row">
          <label>{{localize "TRESPASSER.Sheet.Deed.Params.Placement"}}</label>
          <select name="system.graph.nodes.{{index}}.params.placement" {{#if hasRefArea}}disabled class="is-ref-locked" title="{{localize 'TRESPASSER.Sheet.Deed.Graph.ControlledByReference'}}"{{/if}}>
            <option value="on_target" {{#if (and (eq params.placement "on_target") (not hasRefArea))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TerrainPlacementChoices.OnTarget"}}</option>
            <option value="on_self" {{#if (and (eq params.placement "on_self") (not hasRefArea))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TerrainPlacementChoices.OnSelf"}}</option>
            <option value="choose" {{#if (and (eq params.placement "choose") (not hasRefArea))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TerrainPlacementChoices.Choose"}}</option>
            <option value="selected_area" {{#if (or (eq params.placement "selected_area") hasRefArea)}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.TerrainPlacementChoices.SelectedArea"}}</option>
          </select>
          {{#if hasRefArea}}
            <input type="hidden" name="system.graph.nodes.{{index}}.params.placement" value="selected_area"/>
          {{/if}}
        </div>
        {{#if (eq params.placement "selected_area")}}
          <input type="hidden" name="system.graph.nodes.{{index}}.params.areaBehaviorId" value="{{params.areaBehaviorId}}"/>
        {{/if}}
      </div>
      {{#if (eq params.placement "selected_area")}}
        <div class="behavior-checkboxes-row">
          <div class="field-row checkbox-row">
            <input type="checkbox"
                   name="system.graph.nodes.{{index}}.params.ignoreSourceSquare"
                   {{#if params.ignoreSourceSquare}}checked{{/if}}
                   id="deed-ignore-source-{{id}}"/>
            <label for="deed-ignore-source-{{id}}">
              {{localize "TRESPASSER.Sheet.Deed.Params.IgnoreSourceSquare"}}
            </label>
          </div>
        </div>
      {{/if}}
    </div>
  {{/if}}

  {{#if (eq type "moveTerrain")}}
    <input type="hidden" name="system.graph.nodes.{{index}}.params.terrainBehaviorId" value="{{params.terrainBehaviorId}}"/>
  {{/if}}

  {{#if (eq type "moveSource")}}
    <div class="param-row-grid">
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.Params.DestinationMode"}}</label>
        <select name="system.graph.nodes.{{index}}.params.destinationMode" {{#if hasRefArea}}disabled class="is-ref-locked" title="{{localize 'TRESPASSER.Sheet.Deed.Graph.ControlledByReference'}}"{{/if}}>
          <option value="distance" {{#if (and (or (eq params.destinationMode "distance") (not params.destinationMode)) (not hasRefArea))}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.DestinationModeChoices.Distance"}}</option>
          <option value="selectedArea" {{#if (or (eq params.destinationMode "selectedArea") hasRefArea)}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Deed.Params.DestinationModeChoices.SelectedArea"}}</option>
        </select>
        {{#if hasRefArea}}
          <input type="hidden" name="system.graph.nodes.{{index}}.params.destinationMode" value="selectedArea"/>
        {{/if}}
      </div>
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.Params.MovementType"}}</label>
        <select name="system.graph.nodes.{{index}}.params.movementType">
          <option value="walk" {{#if (eq params.movementType "walk")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.MovementTypeChoices.Walk"}}</option>
          <option value="jump" {{#if (eq params.movementType "jump")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.MovementTypeChoices.Jump"}}</option>
          <option value="teleport" {{#if (eq params.movementType "teleport")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Item.Details.MovementTypeChoices.Teleport"}}</option>
        </select>
      </div>
      {{#if (eq params.destinationMode "selectedArea")}}
        <input type="hidden" name="system.graph.nodes.{{index}}.params.areaBehaviorId" value="{{params.areaBehaviorId}}"/>
      {{/if}}
      {{#unless (eq params.destinationMode "selectedArea")}}
        <div class="field-row">
          <label>{{localize "TRESPASSER.Sheet.Deed.Params.Distance"}}</label>
          <input type="number" name="system.graph.nodes.{{index}}.params.distance"
                 value="{{params.distance}}" min="1" step="1" class="select-on-focus"/>
        </div>
      {{/unless}}
    </div>
  {{/if}}

  {{#if (eq type "forceMoveTargets")}}
    <div class="param-row-grid">
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.Params.ForceMoveType"}}</label>
        <select name="system.graph.nodes.{{index}}.params.type">
          <option value="push" {{#if (eq params.type "push")}}selected{{/if}}>{{localize "TRESPASSER.Terms.ForcedMovement.Push"}}</option>
          <option value="pull" {{#if (eq params.type "pull")}}selected{{/if}}>{{localize "TRESPASSER.Terms.ForcedMovement.Pull"}}</option>
          <option value="sweep" {{#if (eq params.type "sweep")}}selected{{/if}}>{{localize "TRESPASSER.Terms.ForcedMovement.Sweep"}}</option>
          <option value="shove" {{#if (eq params.type "shove")}}selected{{/if}}>{{localize "TRESPASSER.Terms.ForcedMovement.Shove"}}</option>
          <option value="drag" {{#if (eq params.type "drag")}}selected{{/if}}>{{localize "TRESPASSER.Terms.ForcedMovement.Drag"}}</option>
        </select>
      </div>
      <div class="field-row">
        <label>{{localize "TRESPASSER.Sheet.Deed.Params.Distance"}}</label>
        <input type="number" name="system.graph.nodes.{{index}}.params.distance"
               value="{{params.distance}}" min="1" step="1" class="select-on-focus"/>
      </div>
    </div>
  {{/if}}

  {{#if (eq type "clearTargets")}}
    <p class="hint-text">
      <i class="fas fa-info-circle"></i> {{localize "TRESPASSER.Sheet.Deed.Params.ClearTargetsHint"}}
    </p>
  {{/if}}

  {{#if (eq type "executeDeed")}}
    <div class="behavior-deed-section">
      <input type="hidden" name="system.graph.nodes.{{index}}.params.deedUuid" value="{{params.deedUuid}}"/>
      <input type="hidden" name="system.graph.nodes.{{index}}.params.deedName" value="{{params.deedName}}"/>
      <input type="hidden" name="system.graph.nodes.{{index}}.params.deedImg" value="{{params.deedImg}}"/>
      <div class="behavior-deed-drop drop-zone" data-node-id="{{id}}" data-node-index="{{index}}">
        {{#if params.deedName}}
          <div class="deed-chip" style="display:flex; align-items:center; gap:8px;">
            <img src="{{params.deedImg}}" title="{{params.deedName}}" style="width:24px; height:24px; border:none; object-fit:contain;"/>
            <span style="font-weight:bold; font-size:var(--fs-12);">{{params.deedName}}</span>
            <button type="button" class="clear-deed-btn" data-action="clearBehaviorDeed" data-node-id="{{id}}" title="{{localize 'TRESPASSER.Sheet.Deed.Params.ClearDeed'}}">
              <i class="fas fa-times"></i>
            </button>
          </div>
        {{else}}
          <i class="fas fa-file-import"></i> {{localize "TRESPASSER.Sheet.Item.Placeholder.DropDeed"}}
        {{/if}}
      </div>
    </div>
  {{/if}}
</div>
