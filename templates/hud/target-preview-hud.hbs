<div class="trespasser-target-preview-container {{#if isSpectator}}is-spectator{{/if}}">
  {{#each targets as |t|}}
    <div class="target-outcome-card role-{{t.role}} {{#if ../isSpectator}}is-spectator{{/if}}" id="target-pill-{{t.tokenId}}" data-token-id="{{t.tokenId}}" style="--role-color: {{t.style.cssVar}};">
      <div class="target-card-header">
        <span class="role-icon" style="color: {{t.style.cssVar}};" title="{{t.label}}">
          <i class="{{t.style.icon}}"></i>
        </span>
        <span class="target-name" title="{{t.tokenName}}">{{t.tokenName}}</span>
        {{#if t.isSunken}}
          <span class="sunken-pill-badge" title="{{localize 'TRESPASSER.States.Sunken'}}">{{localize 'TRESPASSER.States.Sunken'}} (½)</span>
        {{/if}}
      </div>

      <div class="target-card-body">
        {{#if (or t.anyway.damage.length t.anyway.healing.length t.anyway.effects.length)}}
          <div class="outcome-chip anyway-chip" title="{{localize 'TRESPASSER.HUD.Target.Anyway'}}">
            <span class="chip-val">{{{t.anyway.html}}}</span>
          </div>
        {{/if}}

        {{#if (or t.onMiss.damage.length t.onMiss.healing.length t.onMiss.effects.length)}}
          <div class="outcome-chip on-miss-chip" title="{{localize 'TRESPASSER.HUD.Target.OnMiss'}}">
            <span class="chip-phase-icon"><i class="fa-solid fa-person-running"></i></span>
            <span class="chip-divider"></span>
            <span class="chip-val">{{{t.onMiss.html}}}</span>
          </div>
        {{/if}}

        {{#if (or t.onHit.damage.length t.onHit.healing.length t.onHit.effects.length)}}
          <div class="outcome-chip on-hit-chip" title="{{localize 'TRESPASSER.HUD.Target.OnHit'}}">
            <span class="chip-phase-icon"><i class="fa-solid fa-crosshairs"></i></span>
            <span class="chip-divider"></span>
            <span class="chip-val">{{{t.onHit.html}}}</span>
          </div>
        {{/if}}

        {{#if (or t.onSpark.damage.length t.onSpark.healing.length t.onSpark.effects.length)}}
          <div class="outcome-chip on-spark-chip" title="{{localize 'TRESPASSER.HUD.Target.OnSpark'}}">
            <span class="chip-phase-icon"><i class="fa-solid fa-sun"></i></span>
            <span class="chip-divider"></span>
            <span class="chip-val">{{{t.onSpark.html}}}</span>
          </div>
        {{/if}}
      </div>
    </div>
  {{/each}}
</div>
