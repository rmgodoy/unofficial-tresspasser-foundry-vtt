<section class="trespasser-sheet actor creature">
  
  <header class="sheet-header">
    <div class="header-portrait">
      <div class="actor-avatar-wrapper">
        <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
        <div class="passive-states-overlay">
          {{#each passiveStates}}
            {{#if this.active}}
              <div class="passive-state-icon" data-tooltip="{{localize this.label}}: {{localize this.description}}">
                <img src="{{this.icon}}" alt="{{localize this.label}}" />
              </div>
            {{/if}}
          {{/each}}
        </div>
      </div>
    </div>

    <div class="header-info">
      <!-- Row 1: Name and Configure Action -->
      <div class="header-row creature-identity-row">
        <div class="name-group">
          <input type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'TRESPASSER.Sheet.Header.CreatureNamePlaceholder'}}" />
        </div>
        <a class="creature-config-action-btn" data-action="configureCreature" title="{{localize 'TRESPASSER.Dialog.CreatureConfig.HeaderButton'}}">
          <i class="fas fa-wand-magic-sparkles"></i>
          <span>{{localize "TRESPASSER.Dialog.CreatureConfig.ButtonLabel"}}</span>
        </a>
      </div>

      <!-- Row 2: Level, Role, Template Meta Badges -->
      <div class="header-row creature-meta-row">
        <div class="creature-meta-pill">
          <span class="meta-label">{{localize "TRESPASSER.Sheet.Header.Level"}}</span>
          <input type="number" name="system.level" value="{{system.level}}" min="0" max="20" class="meta-input" />
        </div>
        <div class="creature-meta-pill">
          <span class="meta-label">{{localize "TRESPASSER.Sheet.Header.Role"}}</span>
          <select name="system.role" class="meta-select">
            <option value="archer" {{#if (eq system.role "archer")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Creatures.Roles.Archer"}}</option>
            <option value="enchanter" {{#if (eq system.role "enchanter")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Creatures.Roles.Enchanter"}}</option>
            <option value="enforcer" {{#if (eq system.role "enforcer")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Creatures.Roles.Enforcer"}}</option>
            <option value="guardian" {{#if (eq system.role "guardian")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Creatures.Roles.Guardian"}}</option>
            <option value="harrier" {{#if (eq system.role "harrier")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Creatures.Roles.Harrier"}}</option>
            <option value="hellion" {{#if (eq system.role "hellion")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Creatures.Roles.Hellion"}}</option>
            <option value="stalker" {{#if (eq system.role "stalker")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Creatures.Roles.Stalker"}}</option>
            <option value="sorcerer" {{#if (eq system.role "sorcerer")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Creatures.Roles.Sorcerer"}}</option>
          </select>
        </div>
        <div class="creature-meta-pill">
          <span class="meta-label">{{localize "TRESPASSER.Sheet.Header.Template"}}</span>
          <select name="system.template" class="meta-select">
            <option value="underling" {{#if (eq system.template "underling")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Creatures.Templates.Underling"}}</option>
            <option value="normal" {{#if (eq system.template "normal")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Creatures.Templates.Normal"}}</option>
            <option value="paragon" {{#if (eq system.template "paragon")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Creatures.Templates.Paragon"}}</option>
            <option value="tyrant" {{#if (eq system.template "tyrant")}}selected{{/if}}>{{localize "TRESPASSER.Sheet.Creatures.Templates.Tyrant"}}</option>
          </select>
        </div>
      </div>

      <!-- Row 3: Defenses (Health, Guard, Resist) -->
      <div class="header-row creature-stats-row creature-defenses-row">
        <div class="creature-stat-box health-box">
          <label class="stat-label">{{localize "TRESPASSER.Sheet.Header.Health"}}</label>
          <div class="health-values">
            <input type="number" name="system.health" value="{{system.health}}" min="0" />
            <span class="slash">/</span>
            <input type="number" name="system.max_health" value="{{system.max_health}}" />
          </div>
        </div>
        <div class="creature-stat-box" data-tooltip="{{localize 'TRESPASSER.Sheet.Common.Base'}}: {{system.guard}}">
          <label class="stat-label">
            {{localize "TRESPASSER.Sheet.Combat.Guard"}}
            {{#if (ne system.guard system.combat.guard)}}<small class="mod-val">({{system.combat.guard}})</small>{{/if}}
          </label>
          <input type="number" name="system.guard" value="{{system.guard}}" class="stat-input" />
        </div>
        <div class="creature-stat-box" data-tooltip="{{localize 'TRESPASSER.Sheet.Common.Base'}}: {{system.resist}}">
          <label class="stat-label">
            {{localize "TRESPASSER.Sheet.Combat.Resist"}}
            {{#if (ne system.resist system.combat.resist)}}<small class="mod-val">({{system.combat.resist}})</small>{{/if}}
          </label>
          <input type="number" name="system.resist" value="{{system.resist}}" class="stat-input" />
        </div>
      </div>

      <!-- Row 4: Combat Ratings (Accuracy, Initiative, Speed, Prevail) -->
      <div class="header-row creature-stats-row creature-combat-row">
        <div class="creature-stat-box" data-tooltip="{{localize 'TRESPASSER.Sheet.Common.Base'}}: {{system.accuracy}}">
          <label class="stat-label">
            {{localize "TRESPASSER.Sheet.Combat.Accuracy"}}
            {{#if (ne system.accuracy system.combat.accuracy)}}<small class="mod-val">({{system.combat.accuracy}})</small>{{/if}}
          </label>
          <input type="number" name="system.accuracy" value="{{system.accuracy}}" class="stat-input" />
        </div>
        <div class="creature-stat-box" data-tooltip="{{localize 'TRESPASSER.Sheet.Common.Base'}}: {{system.initiative}}">
          <label class="stat-label">
            {{localize "TRESPASSER.Sheet.Combat.Initiative"}}
            {{#if (ne system.initiative system.combat.initiative)}}<small class="mod-val">({{system.combat.initiative}})</small>{{/if}}
          </label>
          <input type="number" name="system.initiative" value="{{system.initiative}}" class="stat-input" />
        </div>
        <div class="creature-stat-box" data-tooltip="{{localize 'TRESPASSER.Sheet.Common.Base'}}: {{system.speed}}">
          <label class="stat-label">
            {{localize "TRESPASSER.Sheet.Combat.Speed"}}
            {{#if (ne system.speed system.combat.speed)}}<small class="mod-val">({{system.combat.speed}})</small>{{/if}}
          </label>
          <input type="number" name="system.speed" value="{{system.speed}}" class="stat-input" />
        </div>
        <div class="creature-stat-box" data-tooltip="{{localize 'TRESPASSER.Sheet.Common.Base'}}: {{system.prevail}}">
          <label class="stat-label">
            {{localize "TRESPASSER.Sheet.Combat.Prevail"}}
            {{#if (ne system.prevail system.combat.prevail)}}<small class="mod-val">({{system.combat.prevail}})</small>{{/if}}
          </label>
          <input type="number" name="system.prevail" value="{{system.prevail}}" class="stat-input" />
        </div>
      </div>
    </div>
  </header>

  <section class="sheet-body scrollable">
    
    <!-- Features -->
    <div class="features-section" style="margin-top: 10px;">
      <h3 class="section-title" style="display: flex; justify-content: space-between; align-items: center;">
        <span>{{localize "TRESPASSER.Sheet.Tabs.Features"}}</span>
        <a class="item-create button" data-type="feature" title="{{localize "TRESPASSER.Sheet.Common.AddItem"}}">+</a>
      </h3>
      <div class="items-list">
        {{#each features}}
        <div class="item" data-item-id="{{this.id}}" style="display: flex; justify-content: space-between; align-items: center; background: var(--trp-bg-overlay); margin-bottom: 5px; padding: 5px; border-radius: 4px;">
           <span class="item-name feature-name rollable" style="flex: 1; cursor: pointer; color: var(--trp-gold-bright);">{{this.name}}</span>
           <div class="item-controls" style="display: flex; gap: 8px;">
             <a class="feature-info" title="{{localize 'TRESPASSER.Sheet.Common.Info'}}"><i class="fas fa-info-circle"></i></a>
             <a class="item-edit" title="{{localize 'TRESPASSER.Sheet.Common.Edit'}}"><i class="fas fa-edit"></i></a>
             <a class="item-delete" title="{{localize 'TRESPASSER.Sheet.Common.Delete'}}"><i class="fas fa-trash"></i></a>
           </div>
        </div>
        {{/each}}
      </div>
    </div>

    <!-- Combat Effects -->
    {{> "systems/trespasser/templates/actor/parts/combat-effects.hbs"}}

    <!-- Effects (Non-Combat) -->
    <div class="effects-panel" style="margin-top: 15px; border-top: 2px solid var(--trp-border); padding-top: 10px;">
      <h4>{{localize "TRESPASSER.Sheet.Character.NonCombatEffects"}}</h4>
      <div class="effects-list">
        {{#each activeEffects.nonCombat}}
        {{#unless this.hiddenOnSheet}}
        <div class="effect-row" data-item-id="{{this.id}}" style="display: flex; align-items: center; background: var(--trp-bg-overlay); margin-bottom: 5px; padding: 5px; border-radius: 4px;">
          <div style="flex: 1;">
            <b>{{this.name}}</b>{{#if (eq this.type "continuous")}} <span style="font-size: var(--fs-9); opacity: 0.7;">({{localize "TRESPASSER.App.System.Trigger.Continuous"}})</span>{{/if}}
            <a class="effect-info" title="{{localize 'TRESPASSER.Sheet.Common.Info'}}"><i class="fas fa-info-circle"></i></a>
            <a class="effect-edit" title="{{localize 'TRESPASSER.Sheet.Common.Edit'}}"><i class="fas fa-edit"></i></a>
            {{#if this.sourceName}} <span style="font-size: var(--fs-11); font-weight: normal; color: var(--trp-text-dim);">({{this.sourceName}})</span>{{/if}}
            (I: {{this.intensity}}) - {{this.target}}: {{this.modifier}}
          </div>
          <a class="item-control effect-remove" data-action="delete-effect" title="{{localize "TRESPASSER.Sheet.Common.Delete"}}">
            <i class="fas fa-trash"></i>
          </a>
        </div>
        {{/unless}}
        {{else}}
        <p class="notes">{{localize "TRESPASSER.Sheet.Character.NoNonCombatEffects"}}</p>
        {{/each}}
      </div>
    </div>

    <!-- Deeds List -->
    <div class="deeds-section" style="margin-top: 15px;">
      <h3 class="section-title" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0;">
        <span>{{localize "TRESPASSER.Sheet.Combat.Deeds"}}</span>
        <a class="item-create button" data-type="deed" title="{{localize 'TRESPASSER.Sheet.Combat.AddDeed'}}">+</a>
      </h3>
      {{> "systems/trespasser/templates/actor/parts/deed-list.hbs"}}
    </div>

  </section>
</section>
