<section class="trespasser-sheet companion trespasser-character-sheet-layout">
  <!-- ═══════════════════════════════════════════════════
       HEADER
  ════════════════════════════════════════════════════ -->
  <header class="sheet-header">
    <div class="header-portrait">
      <div class="actor-avatar-wrapper">
        <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
        <div class="passive-states-overlay">
          {{#each passiveStates}}
            {{#if this.active}}
              <div class="passive-state-icon" data-tooltip="{{localize this.label}}: {{localize this.description}}">
                <img src="{{this.icon}}" alt="{{localize this.label}}" />
              </div>
            {{/if}}
          {{/each}}
        </div>
      </div>
    </div>

    <div class="header-info">
      <!-- Row 1: Name / Level / Damage Die -->
      <div class="header-row header-identity">
        <div class="name-group">
          <input type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'TRESPASSER.Sheet.Header.NamePlaceholder'}}" />
        </div>
        <div class="level-group">
          <label>{{localize "TRESPASSER.Sheet.Companion.Level"}}</label>
          <input type="number" name="system.level" value="{{system.level}}" min="0" />
        </div>
        <div class="damage-die-group" style="display: flex; align-items: center; gap: 4px;">
          <label>{{localize "TRESPASSER.Sheet.Companion.DamageDie"}}</label>
          <input type="text" name="system.damageDie" value="{{system.damageDie}}" class="damage-die-input" style="width: 50px; text-align: center;" />
        </div>
      </div>

      <!-- Row 2: Bound Character Selector -->
      <div class="header-row bound-character-row">
        <label>{{localize "TRESPASSER.Sheet.Companion.BoundCharacter"}}:</label>
        <select name="system.boundCharacterId" style="flex: 1;">
          <option value="" {{#unless system.boundCharacterId}}selected{{/unless}}>{{localize "TRESPASSER.Sheet.Companion.NoBoundCharacter"}}</option>
          {{#each characterActors}}
          <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </div>

      <!-- Row 3: Resources (Health) -->
      <div class="header-row header-resources">
        <div class="resource-box">
          <label>{{localize "TRESPASSER.Sheet.Companion.Health"}}</label>
          <div class="resource-values">
            <input type="number" name="system.health" value="{{system.health}}" min="0" />
            <span>/</span>
            <input type="number" name="system.max_health" value="{{system.max_health}}" readonly />
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════════
       SHEET NAVIGATION TABS
  ════════════════════════════════════════════════════ -->
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item {{#if (eq tabs.primary 'companion')}}active{{/if}}" data-tab="companion">{{localize "TRESPASSER.Sheet.Companion.TabCompanion"}}</a>
    <a class="item {{#if (eq tabs.primary 'deeds')}}active{{/if}}" data-tab="deeds">{{localize "TRESPASSER.Sheet.Companion.TabDeeds"}}</a>
    <a class="item {{#if (eq tabs.primary 'effects')}}active{{/if}}" data-tab="effects">{{localize "TRESPASSER.Sheet.Companion.TabEffects"}}</a>
    <a class="item {{#if (eq tabs.primary 'notes')}}active{{/if}}" data-tab="notes">{{localize "TRESPASSER.Sheet.Companion.TabNotes"}}</a>
  </nav>

  <!-- ═══════════════════════════════════════════════════
       SHEET BODY
  ════════════════════════════════════════════════════ -->
  <section class="sheet-body scrollable">

    <!-- ─── TAB 1: COMPANION ─── -->
    <div class="tab tab-body {{#if (eq tabs.primary 'companion')}}active{{/if}}" data-group="primary" data-tab="companion">
      
      <!-- Clickable Combat Stat Boxes -->
      <div class="stat-boxes">
        <div class="stat-box rollable" data-roll-stat="speed" data-tooltip="{{localize 'TRESPASSER.Sheet.Companion.Speed'}}">
          <span class="stat-label">{{localize "TRESPASSER.Sheet.Companion.Speed"}}</span>
          <span class="stat-value">{{system.combat.speed}}</span>
        </div>
        <div class="stat-box rollable" data-roll-stat="initiative" data-tooltip="{{localize 'TRESPASSER.Sheet.Companion.Initiative'}}">
          <span class="stat-label">{{localize "TRESPASSER.Sheet.Companion.Initiative"}}</span>
          <span class="stat-value">{{system.combat.initiative}}</span>
        </div>
        <div class="stat-box rollable" data-roll-stat="accuracy" data-tooltip="{{localize 'TRESPASSER.Sheet.Companion.Accuracy'}}">
          <span class="stat-label">{{localize "TRESPASSER.Sheet.Companion.Accuracy"}}</span>
          <span class="stat-value">{{system.combat.accuracy}}</span>
        </div>
        <div class="stat-box rollable" data-roll-stat="guard" data-tooltip="{{localize 'TRESPASSER.Sheet.Companion.Guard'}}">
          <span class="stat-label">{{localize "TRESPASSER.Sheet.Companion.Guard"}}</span>
          <span class="stat-value">{{system.combat.guard}}</span>
        </div>
        <div class="stat-box rollable" data-roll-stat="resist" data-tooltip="{{localize 'TRESPASSER.Sheet.Companion.Resist'}}">
          <span class="stat-label">{{localize "TRESPASSER.Sheet.Companion.Resist"}}</span>
          <span class="stat-value">{{system.combat.resist}}</span>
        </div>
        <div class="stat-box rollable" data-roll-stat="prevail" data-tooltip="{{localize 'TRESPASSER.Sheet.Companion.Prevail'}}">
          <span class="stat-label">{{localize "TRESPASSER.Sheet.Companion.Prevail"}}</span>
          <span class="stat-value">{{system.combat.prevail}}</span>
        </div>
      </div>

      <!-- GM Attribute Formulas (Visible to GM only) -->
      {{#if isGM}}
      <div class="formula-section">
        <h3>{{localize "TRESPASSER.Sheet.Companion.FormulaSection"}}</h3>
        <p class="formula-help" style="font-size: var(--fs-10); color: var(--trp-text-dim); margin-bottom: 6px;">{{localize "TRESPASSER.Sheet.Companion.FormulaHelp"}}</p>
        <div class="formula-row">
          <label>{{localize "TRESPASSER.Sheet.Companion.FormulaHP"}}</label>
          <input type="text" name="system.formulas.hp" value="{{system.formulas.hp}}" />
        </div>
        <div class="formula-row">
          <label>{{localize "TRESPASSER.Sheet.Companion.FormulaSpeed"}}</label>
          <input type="text" name="system.formulas.speed" value="{{system.formulas.speed}}" />
        </div>
        <div class="formula-row">
          <label>{{localize "TRESPASSER.Sheet.Companion.FormulaInitiative"}}</label>
          <input type="text" name="system.formulas.initiative" value="{{system.formulas.initiative}}" />
        </div>
        <div class="formula-row">
          <label>{{localize "TRESPASSER.Sheet.Companion.FormulaAccuracy"}}</label>
          <input type="text" name="system.formulas.accuracy" value="{{system.formulas.accuracy}}" />
        </div>
        <div class="formula-row">
          <label>{{localize "TRESPASSER.Sheet.Companion.FormulaGuard"}}</label>
          <input type="text" name="system.formulas.guard" value="{{system.formulas.guard}}" />
        </div>
        <div class="formula-row">
          <label>{{localize "TRESPASSER.Sheet.Companion.FormulaResist"}}</label>
          <input type="text" name="system.formulas.resist" value="{{system.formulas.resist}}" />
        </div>
        <div class="formula-row">
          <label>{{localize "TRESPASSER.Sheet.Companion.FormulaPrevail"}}</label>
          <input type="text" name="system.formulas.prevail" value="{{system.formulas.prevail}}" />
        </div>
      </div>
      {{/if}}

      <!-- Features Section -->
      <div class="features-panel" style="margin-top: 10px;">
        <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center;">
          <h4>{{localize "TRESPASSER.Sheet.Companion.Features"}}</h4>
          <a class="item-create button" data-type="feature" title="{{localize 'TRESPASSER.Sheet.Common.AddItem'}}">+ {{localize "TRESPASSER.Sheet.Common.AddItem"}}</a>
        </div>
        <ul class="items-list">
          {{#each features}}
          <li class="item" data-item-id="{{this.id}}" draggable="true">
            <span class="item-name feature-name rollable" title="{{localize 'TRESPASSER.Sheet.Combat.ClickView' name=this.name}}">{{this.name}}</span>
            <div class="item-controls">
              <a class="feature-info" title="{{localize 'TRESPASSER.Sheet.Common.Info'}}"><i class="fas fa-info-circle"></i></a>
              <a class="item-edit" title="{{localize 'TRESPASSER.Sheet.Common.Edit'}}"><i class="fas fa-edit"></i></a>
              <a class="item-delete" title="{{localize 'TRESPASSER.Sheet.Common.Delete'}}"><i class="fas fa-trash"></i></a>
            </div>
          </li>
          {{else}}
          <li class="empty-list" style="font-size: var(--fs-12); color: var(--trp-text-dim); padding: 4px;">{{localize "TRESPASSER.Sheet.Character.NoFeatures"}}</li>
          {{/each}}
        </ul>
      </div>

      <!-- Inventory Section -->
      <div class="inventory-section" style="margin-top: 10px;">
        <div class="inventory-header" style="display: flex; justify-content: space-between; align-items: center;">
          <h4>{{localize "TRESPASSER.Sheet.Companion.Inventory"}} <span class="slot-count" style="font-size: var(--fs-11); color: var(--trp-text-dim);">({{inventoryUsed}} / {{inventoryMax}})</span></h4>
          <div style="display: flex; gap: 8px; align-items: center;">
            {{#if isGM}}
            <label style="font-size: var(--fs-10); color: var(--trp-text-dim);">{{localize "TRESPASSER.Sheet.Companion.InventoryCapacity"}}:</label>
            <input type="number" name="system.inventory_max" value="{{system.inventory_max}}" style="width: 40px; text-align: center;" />
            {{/if}}
            <a class="item-create button" data-type="item" title="{{localize 'TRESPASSER.Sheet.Common.AddItem'}}">+ {{localize "TRESPASSER.Sheet.Common.AddItem"}}</a>
          </div>
        </div>
        <div class="inventory-grid">
          {{#each inventory}}
          <div class="inventory-card" data-item-id="{{this.id}}" draggable="true">
            <img src="{{this.img}}" class="item-icon" title="{{this.name}}" />
            <span class="item-name">{{this.name}}</span>
            <div class="item-controls">
              <a class="item-edit" title="{{localize 'TRESPASSER.Sheet.Common.Edit'}}"><i class="fas fa-edit"></i></a>
              <a class="item-delete" title="{{localize 'TRESPASSER.Sheet.Common.Delete'}}"><i class="fas fa-trash"></i></a>
            </div>
          </div>
          {{else}}
          <div class="empty-list" style="font-size: var(--fs-12); color: var(--trp-text-dim); padding: 4px;">{{localize "TRESPASSER.Sheet.Character.Inventory.EmptyInventory"}}</div>
          {{/each}}
        </div>
      </div>
    </div>

    <!-- ─── TAB 2: DEEDS ─── -->
    <div class="tab tab-body {{#if (eq tabs.primary 'deeds')}}active{{/if}}" data-group="primary" data-tab="deeds">
      <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <h4>{{localize "TRESPASSER.Sheet.Companion.TabDeeds"}}</h4>
        <a class="item-create button" data-type="deed" title="{{localize 'TRESPASSER.Sheet.Common.AddItem'}}">+ {{localize "TRESPASSER.Sheet.Common.AddItem"}}</a>
      </div>
      {{> "systems/trespasser/templates/actor/parts/deed-list.hbs"}}
    </div>

    <!-- ─── TAB 3: EFFECTS ─── -->
    <div class="tab tab-body {{#if (eq tabs.primary 'effects')}}active{{/if}}" data-group="primary" data-tab="effects">
      <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <h4>{{localize "TRESPASSER.Sheet.Companion.TabEffects"}}</h4>
        <a class="item-create button" data-type="effect" title="{{localize 'TRESPASSER.Sheet.Common.AddItem'}}">+ {{localize "TRESPASSER.Sheet.Common.AddItem"}}</a>
      </div>
      {{> "systems/trespasser/templates/actor/parts/combat-effects.hbs"}}
    </div>

    <!-- ─── TAB 4: NOTES ─── -->
    <div class="tab tab-body {{#if (eq tabs.primary 'notes')}}active{{/if}}" data-group="primary" data-tab="notes">
      <div class="editor-container" style="height: 100%; min-height: 250px;">
        {{editor system.notes target="system.notes" button=true owner=owner editable=editable engine="prosemirror"}}
      </div>
    </div>

  </section>
</section>
