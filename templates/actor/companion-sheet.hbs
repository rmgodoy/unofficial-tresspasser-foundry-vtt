<section class="trespasser-sheet companion trespasser-character-sheet-layout">
  <!-- ═══════════════════════════════════════════════════
       HEADER
  ════════════════════════════════════════════════════ -->
  <header class="sheet-header">
    <div class="header-portrait">
      <div class="actor-avatar-wrapper">
        <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
        <div class="passive-states-overlay">
          {{#each passiveStates}}
            {{#if this.active}}
              <div class="passive-state-icon" data-tooltip="{{localize this.label}}: {{localize this.description}}">
                <img src="{{this.icon}}" alt="{{localize this.label}}" />
              </div>
            {{/if}}
          {{/each}}
        </div>
      </div>
    </div>

    <div class="header-info">
      <!-- Row 1: Name / Level / Bound Character -->
      <div class="header-row header-identity">
        <div class="name-group">
          <input type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'TRESPASSER.Sheet.Header.NamePlaceholder'}}" />
        </div>
        <div class="identity-meta">
          <div class="level-group">
            <label>{{localize "TRESPASSER.Sheet.Header.Level"}}</label>
            <span class="level-display" title="{{localize 'TRESPASSER.Sheet.Header.Level'}}">{{system.level}}</span>
          </div>
          <div class="bound-character-group">
            <label>{{localize "TRESPASSER.Sheet.Companion.BoundCharacter"}}:</label>
            <select name="system.boundCharacterId">
              <option value="" {{#unless system.boundCharacterId}}selected{{/unless}}>{{localize "TRESPASSER.Sheet.Companion.NoBoundCharacter"}}</option>
              {{#each characterActors}}
              <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>
            {{#if isGM}}
            <a class="companion-config-btn" data-action="configure-formulas" title="{{localize 'TRESPASSER.Sheet.Companion.ConfigureFormulas'}}">
              <i class="fas fa-cog"></i>
            </a>
            {{/if}}
          </div>
        </div>
      </div>

      <!-- Row 2: Resources (Health, Damage Die) -->
      <div class="header-row header-resources">
        <div class="resource-box">
          <label>{{localize "TRESPASSER.Sheet.Header.HP"}}</label>
          <div class="resource-values">
            <input type="number" name="system.health" value="{{system.health}}" min="0" />
            <span>/</span>
            <input type="number" name="system.max_health" value="{{system.max_health}}" readonly />
          </div>
        </div>
        <div class="resource-box rollable" data-action="roll-skill-die" data-tooltip="{{localize 'TRESPASSER.Sheet.Combat.ClickRollCheck' label=(localize 'TRESPASSER.Sheet.Combat.SkillDie')}} ({{system.skill_die}})">
          <label class="rollable">{{localize "TRESPASSER.Sheet.Combat.SkillDie"}}</label>
          <span class="damage-die-display">{{system.skill_die}}</span>
        </div>
      </div>

      <!-- Row 3: Attributes (Initiative, Accuracy, Guard, Resist, Prevail, Speed) -->
      <div class="header-row header-attributes">
        {{#if showInitiativeStat}}
        <div class="attribute-box rollable" data-roll-stat="initiative" data-tooltip="{{localize 'TRESPASSER.Sheet.Combat.ClickRollCheck' label=(localize 'TRESPASSER.Sheet.Companion.Initiative')}}">
          <span class="attribute-label attribute-roll">
            {{localize "TRESPASSER.Sheet.Companion.Initiative"}}
            <h3>{{system.combat.initiative}}</h3>
          </span>
        </div>
        {{/if}}
        {{#each (array "accuracy" "guard" "resist" "prevail") as |stat|}}
        <div class="attribute-box rollable" data-roll-stat="{{stat}}" data-tooltip="{{localize 'TRESPASSER.Sheet.Combat.ClickRollCheck' label=(localize (concat 'TRESPASSER.Sheet.Companion.' (capitalize stat)))}}">
          <span class="attribute-label attribute-roll">
            {{localize (concat "TRESPASSER.Sheet.Companion." (capitalize stat))}}
            <h3>{{lookup ../system.combat stat}}</h3>
          </span>
        </div>
        {{/each}}
        <div class="attribute-box attribute-box-speed">
          <span class="attribute-label">
            {{localize "TRESPASSER.Sheet.Companion.Speed"}}
            <h3>{{system.combat.speed}}<span class="speed-separator">/</span><span class="speed-bonus-value">+{{system.combat.speed_bonus}}</span></h3>
          </span>
        </div>
      </div>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════════
       SHEET NAVIGATION TABS: Combat, Inventory, Notes
  ════════════════════════════════════════════════════ -->
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item {{#if (eq tabs.primary 'combat')}}active{{/if}}" data-tab="combat">{{localize "TRESPASSER.Sheet.Tabs.Combat"}}</a>
    <a class="item {{#if (eq tabs.primary 'inventory')}}active{{/if}}" data-tab="inventory">{{localize "TRESPASSER.Sheet.Tabs.Inventory"}}</a>
    <a class="item {{#if (eq tabs.primary 'notes')}}active{{/if}}" data-tab="notes">{{localize "TRESPASSER.Sheet.Tabs.Notes"}}</a>
  </nav>

  <!-- ═══════════════════════════════════════════════════
       SHEET BODY
  ════════════════════════════════════════════════════ -->
  <section class="sheet-body scrollable">

    <!-- ─── TAB 1: COMBAT (Features, Deeds, Effects, GM Formulas) ─── -->
    <div class="tab tab-body {{#if (eq tabs.primary 'combat')}}active{{/if}}" data-group="primary" data-tab="combat">
      
      <!-- Features (Características) Section -->
      <div class="features-panel">
        <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center;">
          <h4>{{localize "TRESPASSER.Sheet.Companion.Features"}}</h4>
          <a class="item-create button" data-type="feature" title="{{localize 'TRESPASSER.Sheet.Common.AddItem'}}">+ {{localize "TRESPASSER.Sheet.Common.AddItem"}}</a>
        </div>
        <ul class="items-list">
          {{#each features}}
          <li class="item" data-item-id="{{this.id}}" draggable="true">
            <span class="item-name feature-name rollable" title="{{localize 'TRESPASSER.Sheet.Combat.ClickView' name=this.name}}">{{this.name}}</span>
            <div class="item-controls">
              <a class="feature-info" title="{{localize 'TRESPASSER.Sheet.Common.Info'}}"><i class="fas fa-info-circle"></i></a>
              <a class="item-edit" title="{{localize 'TRESPASSER.Sheet.Common.Edit'}}"><i class="fas fa-edit"></i></a>
              <a class="item-delete" title="{{localize 'TRESPASSER.Sheet.Common.Delete'}}"><i class="fas fa-trash"></i></a>
            </div>
          </li>
          {{else}}
          <li class="empty-list" style="font-size: var(--fs-12); color: var(--trp-text-dim); padding: 4px;">{{localize "TRESPASSER.Sheet.Character.NoFeatures"}}</li>
          {{/each}}
        </ul>
      </div>

      <!-- Deeds (Habilidades) Section -->
      <div class="deeds-panel" style="margin-top: 12px;">
        <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <h4>{{localize "TRESPASSER.Sheet.Companion.TabDeeds"}}</h4>
          <a class="item-create button" data-type="deed" title="{{localize 'TRESPASSER.Sheet.Common.AddItem'}}">+ {{localize "TRESPASSER.Sheet.Common.AddItem"}}</a>
        </div>
        {{> "systems/trespasser/templates/actor/parts/deed-list.hbs"}}
      </div>

      <!-- Effects (Efeitos) Section -->
      <div class="effects-panel" style="margin-top: 12px;">
        <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <h4>{{localize "TRESPASSER.Sheet.Companion.TabEffects"}}</h4>
          <a class="item-create button" data-type="effect" title="{{localize 'TRESPASSER.Sheet.Common.AddItem'}}">+ {{localize "TRESPASSER.Sheet.Common.AddItem"}}</a>
        </div>
        {{> "systems/trespasser/templates/actor/parts/combat-effects.hbs"}}

        <!-- Non-Combat Effects (Efeitos Fora de Combate) -->
        <div class="non-combat-effects-section">
          <h4 class="section-title">
            {{localize "TRESPASSER.Sheet.Character.NonCombatEffects"}}
          </h4>
          <div class="effects-list">
            {{#each activeEffects.nonCombat}}
            {{#unless this.hiddenOnSheet}}
            <div class="effect-row non-combat-effect" data-item-id="{{this.id}}">
              <div class="effect-info-wrapper">
                <b>{{this.name}}</b>
                {{#if (eq this.type "continuous")}} <span class="continuous-badge" style="font-size: var(--fs-9); opacity: 0.7;">({{localize "TRESPASSER.App.System.Trigger.Continuous"}})</span>{{/if}}
                {{#if (eq this.type "movement")}} <span class="continuous-badge" style="font-size: var(--fs-9); opacity: 0.7;">({{localize "TRESPASSER.Sheet.Item.Details.EffectTypeChoices.Movement"}})</span>{{/if}}
                <a class="effect-info" title="{{localize 'TRESPASSER.Sheet.Common.Info'}}"><i class="fas fa-info-circle"></i></a>
                <a class="effect-edit" title="{{localize 'TRESPASSER.Sheet.Common.Edit'}}"><i class="fas fa-edit"></i></a>
                {{#if this.sourceName}} <span class="effect-source" style="font-size: var(--fs-11); font-weight: normal; color: var(--trp-text-dim);">({{this.sourceName}})</span>{{/if}}
                {{#if (eq this.type "movement")}}
                  <span class="effect-details">— {{localize "TRESPASSER.Sheet.Item.Details.MovementType"}}: {{this.movementTypeLabel}}</span>
                {{else}}
                  <span class="effect-details">(I: {{this.intensity}}) — {{this.target}}: {{this.modifier}}</span>
                {{/if}}
              </div>
              <a class="item-control effect-remove" data-action="delete-effect" title="{{localize 'TRESPASSER.Sheet.Common.Delete'}}">
                <i class="fas fa-trash"></i>
              </a>
            </div>
            {{/unless}}
            {{else}}
            <div class="empty-list" style="font-size: var(--fs-12); color: var(--trp-text-dim); padding: 4px;">{{localize "TRESPASSER.Sheet.Character.NoNonCombatEffects"}}</div>
            {{/each}}
          </div>
        </div>
      </div>



    </div>

    <!-- ─── TAB 2: INVENTORY & EQUIPMENT ─── -->
    <div class="tab tab-body {{#if (eq tabs.primary 'inventory')}}active{{/if}}" data-group="primary" data-tab="inventory">
      
      <!-- Equipped Items Section -->
      <div class="companion-equipment-section">
        <div class="equipment-section-header">
          <div class="section-title-group">
            <h4 class="section-title">
              <i class="fas fa-shield-alt"></i> {{localize "TRESPASSER.Sheet.Companion.EquippedItems"}}
            </h4>
            <span class="engagement-range-badge">
              <i class="fas fa-crosshairs"></i> {{localize "TRESPASSER.Sheet.Creatures.EngagementRange"}}: <strong>{{engagementRange}}</strong> {{localize "TRESPASSER.HUD.Movement.Label"}}
            </span>
          </div>
        </div>

        <div class="equipped-slots-grid">
          <!-- Main Hand -->
          <div class="equipped-slot-card main-hand-slot" data-slot="main_hand">
            <div class="slot-header">
              <span class="slot-name">{{localize "TRESPASSER.Sheet.Companion.MainHand"}}</span>
            </div>
            {{#if equippedMainHand}}
              <div class="equipped-item-row" data-item-id="{{equippedMainHand.id}}">
                <img src="{{equippedMainHand.img}}" class="equipped-item-icon" title="{{equippedMainHand.name}}" />
                <div class="equipped-item-details">
                  <span class="item-name" title="{{equippedMainHand.name}}">{{equippedMainHand.name}}</span>
                  <div class="item-meta">
                    {{#if (eq equippedMainHand.type "weapon")}}
                      <span class="meta-tag weapon-die">{{equippedMainHand.system.weaponDie}}</span>
                      <span class="meta-tag weapon-type">{{localize (concat "TRESPASSER.Sheet.Item.Details." (capitalize equippedMainHand.system.type))}}</span>
                      {{#if (eq equippedMainHand.system.type "melee")}}
                        <span class="meta-tag weapon-range">{{localize "TRESPASSER.Sheet.Item.Details.MeleeRange"}} {{#if equippedMainHand.system.meleeRange}}{{equippedMainHand.system.meleeRange}}{{else}}1{{/if}}</span>
                        {{#if equippedMainHand.system.properties.thrown}}
                          <span class="meta-tag weapon-range">{{localize "TRESPASSER.Sheet.Item.Details.ThrownRange"}} {{#if equippedMainHand.system.thrownRange}}{{equippedMainHand.system.thrownRange}}{{else}}{{equippedMainHand.system.range}}{{/if}}</span>
                        {{/if}}
                      {{else}}
                        <span class="meta-tag weapon-range">{{localize "TRESPASSER.Sheet.Common.Range"}} {{equippedMainHand.system.range}}</span>
                      {{/if}}
                    {{else if equippedMainHand.system.armorDie}}
                      <span class="meta-tag armor-die">{{equippedMainHand.system.armorDie}}</span>
                    {{/if}}
                  </div>
                </div>
                <div class="item-actions">
                  <a class="item-edit" data-item-id="{{equippedMainHand.id}}" title="{{localize 'TRESPASSER.Sheet.Common.Edit'}}"><i class="fas fa-edit"></i></a>
                  <a class="item-unequip" data-item-id="{{equippedMainHand.id}}" title="{{localize 'TRESPASSER.Sheet.Common.Unequip'}}"><i class="fas fa-times-circle"></i></a>
                </div>
              </div>
            {{else}}
              <div class="equipped-slot-empty">
                <span>{{localize "TRESPASSER.Sheet.Companion.EmptySlot"}}</span>
              </div>
            {{/if}}
          </div>

          <!-- Off Hand -->
          <div class="equipped-slot-card off-hand-slot" data-slot="off_hand">
            <div class="slot-header">
              <span class="slot-name">{{localize "TRESPASSER.Sheet.Companion.OffHand"}}</span>
            </div>
            {{#if isTwoHanded}}
              <div class="equipped-slot-occupied">
                <i class="fas fa-link"></i>
                <span>{{localize "TRESPASSER.Sheet.Companion.TwoHandOccupied"}}</span>
              </div>
            {{else if equippedOffHand}}
              <div class="equipped-item-row" data-item-id="{{equippedOffHand.id}}">
                <img src="{{equippedOffHand.img}}" class="equipped-item-icon" title="{{equippedOffHand.name}}" />
                <div class="equipped-item-details">
                  <span class="item-name" title="{{equippedOffHand.name}}">{{equippedOffHand.name}}</span>
                  <div class="item-meta">
                    {{#if (eq equippedOffHand.type "weapon")}}
                      <span class="meta-tag weapon-die">{{equippedOffHand.system.weaponDie}}</span>
                      <span class="meta-tag weapon-type">{{localize (concat "TRESPASSER.Sheet.Item.Details." (capitalize equippedOffHand.system.type))}}</span>
                      {{#if (eq equippedOffHand.system.type "melee")}}
                        <span class="meta-tag weapon-range">{{localize "TRESPASSER.Sheet.Item.Details.MeleeRange"}} {{#if equippedOffHand.system.meleeRange}}{{equippedOffHand.system.meleeRange}}{{else}}1{{/if}}</span>
                        {{#if equippedOffHand.system.properties.thrown}}
                          <span class="meta-tag weapon-range">{{localize "TRESPASSER.Sheet.Item.Details.ThrownRange"}} {{#if equippedOffHand.system.thrownRange}}{{equippedOffHand.system.thrownRange}}{{else}}{{equippedOffHand.system.range}}{{/if}}</span>
                        {{/if}}
                      {{else}}
                        <span class="meta-tag weapon-range">{{localize "TRESPASSER.Sheet.Common.Range"}} {{equippedOffHand.system.range}}</span>
                      {{/if}}
                    {{else if equippedOffHand.system.armorDie}}
                      <span class="meta-tag armor-die">{{equippedOffHand.system.armorDie}}</span>
                    {{/if}}
                  </div>
                </div>
                <div class="item-actions">
                  <a class="item-edit" data-item-id="{{equippedOffHand.id}}" title="{{localize 'TRESPASSER.Sheet.Common.Edit'}}"><i class="fas fa-edit"></i></a>
                  <a class="item-unequip" data-item-id="{{equippedOffHand.id}}" title="{{localize 'TRESPASSER.Sheet.Common.Unequip'}}"><i class="fas fa-times-circle"></i></a>
                </div>
              </div>
            {{else}}
              <div class="equipped-slot-empty">
                <span>{{localize "TRESPASSER.Sheet.Companion.EmptySlot"}}</span>
              </div>
            {{/if}}
          </div>
        </div>

        {{#if otherEquipped.length}}
        <!-- Other Equipped Items (Armor, Shield, Accessories) -->
        <div class="other-equipped-list">
          <div class="other-equipped-title">{{localize "TRESPASSER.Sheet.Companion.OtherEquipped"}}:</div>
          <div class="other-equipped-chips">
            {{#each otherEquipped}}
            <div class="equipped-chip" data-item-id="{{this.id}}">
              <img src="{{this.img}}" class="chip-icon" title="{{this.name}}" />
              <span class="chip-name item-name">{{this.name}}</span>
              {{#if this.system.placement}}
                <span class="chip-slot">({{localize (concat "TRESPASSER.Sheet.Common.Slots." this.system.placement)}})</span>
              {{/if}}
              <a class="item-unequip" data-item-id="{{this.id}}" title="{{localize 'TRESPASSER.Sheet.Common.Unequip'}}"><i class="fas fa-times-circle"></i></a>
            </div>
            {{/each}}
          </div>
        </div>
        {{/if}}
      </div>

      <!-- Inventory / Stored Items Header -->
      <div class="inventory-header" style="margin-top: 14px;">
        <span class="inventory-cap">{{localize "TRESPASSER.Sheet.Companion.Inventory"}}: {{inventoryUsed}} / {{inventoryMax}}</span>
        <div style="display: flex; gap: 8px; align-items: center;">
          {{#if isGM}}
          <label style="font-size: var(--fs-10); color: var(--trp-text-dim);">{{localize "TRESPASSER.Sheet.Companion.InventoryCapacity"}}:</label>
          <input type="number" name="system.inventory_max" value="{{system.inventory_max}}" style="width: 40px; text-align: center;" />
          {{/if}}
          <a class="item-create button" data-type="inventory" title="{{localize 'TRESPASSER.Sheet.Common.AddItem'}}">+ {{localize "TRESPASSER.Sheet.Common.AddItem"}}</a>
        </div>
      </div>

      <div class="inventory-grid">
        {{#each inventory}}
        {{> "systems/trespasser/templates/actor/parts/inventory-card.hbs" item=this transferTarget=../transferTarget isCompanion=true}}
        {{else}}
        <div class="empty-list" style="grid-column:1/-1">{{localize "TRESPASSER.Sheet.Character.Inventory.EmptyInventory"}}</div>
        {{/each}}
      </div>
    </div>

    <!-- ─── TAB 3: NOTES ─── -->
    <div class="tab tab-body notes {{#if (eq tabs.primary 'notes')}}active{{/if}}" data-group="primary" data-tab="notes">
      <div class="editor-container">
        <prose-mirror name="system.notes" value="{{system.notes}}" toggled="false" compact="false" {{#if (not editable)}}readonly{{/if}}>{{{enrichedNotes}}}</prose-mirror>
      </div>
    </div>

  </section>
</section>
